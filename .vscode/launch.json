{
    // Rust: launch with CodeLLDB via cargo, pass input file as arg
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Debug union-find",
            "cargo": {
                "args": ["run", "--bin", "union-find"],
                "filter": { "kind": "bin" }
            },
            "args": ["${workspaceFolder}/data/union-find/tinyUF.txt"],
            "cwd": "${workspaceFolder}",
            "env": {},
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Rust: Release union-find",
            "cargo": {
                "args": ["run", "--release", "--bin", "union-find"],
                "filter": { "kind": "bin" }
            },
            "args": ["${workspaceFolder}/data/union-find/tinyUF.txt"],
            "cwd": "${workspaceFolder}",
            "env": {},
            "sourceLanguages": ["rust"]
        }
    ]
}